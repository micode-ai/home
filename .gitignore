# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Python bytecode caches (docs/marketing/ scripts + pytest suite)
__pycache__/

# Generated by scripts/prerender.mjs on every `npm run build` — drifts stale if committed
# between builds. CI regenerates it from current content on every deploy.
public/sitemap.xml

# Generated by scripts/generate-og-images.mjs during `prebuild`, same reasoning: derived
# from blog-posts.json titles, so committed copies go stale the moment a title changes.
# The fonts they're rendered with (scripts/og-fonts/) ARE committed — those are inputs.
public/og/

# Generated by scripts/generate-company-profile-pdf.mjs during `prebuild` — derived from
# pl.json/en.json/ru.json + services.json, same reasoning as public/og/ above.
public/downloads/

# Scratch workspace for subagent-driven plan execution (ledger, briefs, review packages).
# Process artifacts, not project history — git log is the record.
.superpowers/

