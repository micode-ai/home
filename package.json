{
  "name": "micode-landing-page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-github-npm-stats.js && node scripts/generate-og-images.mjs && node scripts/generate-company-profile-pdf.mjs",
    "build": "vite build && vite build --config vite.ssr.config.ts && node scripts/prerender.mjs",
    "preview": "vite preview",
    "ai-visibility": "node scripts/ai-visibility/run.mjs",
    "ai-visibility:manual": "node scripts/ai-visibility/manual.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.6",
    "fast-check": "^4.5.3",
    "jsdom": "^27.4.0",
    "pdf-lib": "^1.17.1",
    "satori": "^0.29.0",
    "svelte": "^5.43.8",
    "svelte-check": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "npm:rolldown-vite@7.2.5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "mermaid": "^11.16.0"
  }
